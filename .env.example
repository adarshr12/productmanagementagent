# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" — it holds secrets. (.gitignore already blocks it.)
#
# Which of these reach the browser?
#   - Anything starting with NEXT_PUBLIC_  -> sent to the browser (safe, public).
#   - Everything else                       -> stays on the server ONLY (secret).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (from your Supabase project: Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET service-role key. Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (embeddings) — https://aistudio.google.com/apikey ---
# Free tier, no credit card. Powers the RAG embeddings (was Voyage before).
GEMINI_API_KEY=your-gemini-key
# Model + output size. GEMINI_EMBED_DIM must match the vector(...) size in the
# database migration (currently 768). Change both together if you switch.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- Groq (the LLM) — https://console.groq.com/keys ---
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- App settings ---
# Max intake-form submissions per visitor per hour (spam protection).
RATE_LIMIT_PER_HOUR=5
# Max assistant chat messages per visitor per hour.
ASSISTANT_RATE_LIMIT_PER_HOUR=40
# Base URL of the deployed site.
NEXT_PUBLIC_SITE_URL=https://productmanagementagent.vercel.app
