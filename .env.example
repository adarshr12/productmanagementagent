# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" — it holds secrets. (.gitignore already blocks it.)
#
# Which of these reach the browser?
#   - Anything starting with NEXT_PUBLIC_  -> sent to the browser (safe, public).
#   - Everything else                       -> stays on the server ONLY (secret).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (from your Supabase project: Settings -> API) ---
# Public URL of your Supabase project. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public "anon" key. Safe for the browser (used only for admin login).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET "service role" key. Server only. This bypasses all security rules —
# it must NEVER appear in browser code or be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Voyage AI (embeddings) — https://dash.voyageai.com ---
VOYAGE_API_KEY=your-voyage-key
# The embedding model + its output size. Must match the vector(...) size in the
# database migration. Change both together if you ever switch models.
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_DIM=1024

# --- Groq (the roadmap LLM) — https://console.groq.com/keys ---
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- App settings ---
# Max intake-form submissions allowed per visitor per hour (spam protection).
RATE_LIMIT_PER_HOUR=5
# Base URL of the deployed site, used to build shareable roadmap links.
NEXT_PUBLIC_SITE_URL=https://start.yourdomain.com
